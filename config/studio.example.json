{
  "omni": {
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "omni-default",
    "max_tokens": 4096,
    "operations_max_tokens": 8192,
    "temperature": 0.6,
    "summary_temperature": 1.0,
    "enable_thinking": true,
    "timeout_seconds": 40,
    "prefill_timeout_seconds": 1200,
    "auto_compact_token_limit_scope": "total",
    "effective_context_window_percent": 95,
    "compaction_max_tokens": 2048,
    "compaction_max_retries": 3,
    "compaction_timeout_seconds": 1200,
    "context_source": "model_card",
    "structured_output": "structural_tag",
    "prompt_token_endpoint": true,
    "top_k": 20,
    "top_p": 0.95,
    "responses_model": "llm-default",
    "responses_options": {
      "max_output_tokens": 4096,
      "timeout_seconds": 120,
      "parallel_reads": 2
    }
  },
  "voice_id": "whale_reference",
  "features": {
    "live_enabled": false
  },
  "queue_limit": 40,
  "event_ttl_seconds": 90,
  "playback_wait_seconds": 45,
  "commercial_mode": false,
  "conversation_retention_days": 30
}
