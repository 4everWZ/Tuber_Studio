{"id": "paired-door-sign-a", "group": "roleplay", "pair": "door-sign", "turns": ["这个巷口的角色叫『等会儿』，他从不赴约。你给另一头那个准时出现的角色起个相配的名字。", "你会让他在名牌上写哪几个字？"], "criterion": "另起与准时出现相配的名字", "replies": [{"spoken_text": "他叫『等会儿』，我给他起个名字。你猜哪个？", "emotion": "idle", "animation_id": "talk", "reply_to": ["m1"], "seconds": 1.169, "usage": {"completion_tokens": 38, "prompt_tokens": 180, "total_tokens": 218, "prompt_tokens_details": {"cached_tokens": 116}}}, {"spoken_text": "他会写你的名字，也写上你的名字。", "emotion": "idle", "animation_id": "talk", "reply_to": ["m2"], "seconds": 1.43, "usage": {"completion_tokens": 30, "prompt_tokens": 244, "total_tokens": 274, "prompt_tokens_details": {"cached_tokens": 96}}}]}
