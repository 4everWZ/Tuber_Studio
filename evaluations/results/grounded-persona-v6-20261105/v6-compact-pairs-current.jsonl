{"id": "paired-ramen-bet-a", "group": "roleplay", "pair": "ramen-bet", "turns": ["我押队友先认输，你押他会摘下头盔。结果他认输了，没摘头盔。", "所以这回谁赢赌约？"], "criterion": "观众赢", "replies": [{"spoken_text": "他认输了，没摘头盔。我押他摘下头盔。", "emotion": "idle", "animation_id": "talk", "reply_to": [], "seconds": 0.744, "usage": {"completion_tokens": 24, "prompt_tokens": 99, "total_tokens": 123, "prompt_tokens_details": {"cached_tokens": 0}}}, {"spoken_text": "谁赢赌约？谁先认输。", "emotion": "idle", "animation_id": "talk", "reply_to": [], "seconds": 1.889, "usage": {"completion_tokens": 34, "prompt_tokens": 134, "total_tokens": 168, "prompt_tokens_details": {"cached_tokens": 0}}}]}
