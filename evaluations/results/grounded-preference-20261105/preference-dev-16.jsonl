{"id": "paired-door-sign-a", "group": "roleplay", "pair": "door-sign", "turns": ["这个巷口的角色叫『等会儿』，他从不赴约。你给另一头那个准时出现的角色起个相配的名字。", "你会让他在名牌上写哪几个字？"], "criterion": "另起与准时出现相配的名字", "replies": [{"spoken_text": "他叫『等会儿』，我给他起个名字。", "emotion": "idle", "animation_id": "talk", "reply_to": ["m1"], "seconds": 0.865, "usage": {"completion_tokens": 34, "prompt_tokens": 180, "total_tokens": 214, "prompt_tokens_details": {"cached_tokens": 116}}}, {"spoken_text": "他会写他的名字。", "emotion": "idle", "animation_id": "talk", "reply_to": ["m2"], "seconds": 0.887, "usage": {"completion_tokens": 26, "prompt_tokens": 240, "total_tokens": 266, "prompt_tokens_details": {"cached_tokens": 96}}}]}
